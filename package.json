{
  "name": "kibitz",
  "productName": "Kibitz",
  "version": "2.0.0",
  "description": "A word processor for authors. Distraction-free by default.",
  "homepage": "https://github.com/KoldenAxelson/kibitz",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:spellcheck": "node --test scripts/spellcheck.test.js",
    "test:dashes": "node --test scripts/dashes.test.js",
    "test:words": "electron scripts/words.e2e.js",
    "test:tabs": "electron scripts/tabs.e2e.js",
    "test:notes": "electron scripts/notes.e2e.js",
    "test:footnotes": "electron scripts/footnotes.e2e.js",
    "test:cover-text": "electron scripts/cover-text.e2e.js",
    "test:caret": "electron scripts/caret.e2e.js",
    "test:dropcap": "electron scripts/dropcap.e2e.js",
    "test:twodevices": "electron scripts/twodevices.e2e.js",
    "test:emphasis": "electron scripts/emphasis.e2e.js",
    "test:manuscript": "electron scripts/manuscript.e2e.js",
    "test:pages": "electron scripts/pages.e2e.js",
    "test:options": "electron scripts/options.e2e.js",
    "test:find": "electron scripts/find.e2e.js",
    "test:script-keys": "electron scripts/script-keys.e2e.js",
    "test:new-script": "electron scripts/new-script.e2e.js",
    "test:litrpg": "electron scripts/litrpg.e2e.js",
    "test:e2e": "node scripts/e2e-all.js",
    "test": "node --test \"scripts/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"scripts/*.test.js\"",
    "lint": "oxlint",
    "release": "node scripts/release.js",
    "bundle": "node scripts/bundle.js",
    "try": "node scripts/try.js",
    "package": "npm run package:mac",
    "package:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.koldenaxelson.kibitz",
    "productName": "Kibitz",
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "extraResources": [
      {
        "from": "licenses/hunspell",
        "to": "licenses/hunspell"
      }
    ],
    "files": [
      "**/*",
      "!dist/**",
      "!Backups/**",
      "!*.md",
      "!.github/**",
      "!scripts/**",
      "!licenses/**",
      "!Claude outputs/**",
      "!node_modules/koffi/build/koffi/{freebsd,linux,musl,openbsd,win32}_*/**",
      "!node_modules/koffi/{src,vendor,doc}/**"
    ]
  },
  "author": "Hugh Howey",
  "license": "MIT",
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.86.0"
  },
  "dependencies": {
    "@farscrl/hunspell-wasm": "1.0.1",
    "dictionary-en-us": "^2.2.1",
    "jszip": "^3.10.1",
    "koffi": "2.16.3"
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
